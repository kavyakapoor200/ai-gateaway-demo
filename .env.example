# ==============================================================================
# Environment Configuration for Local AI Gateway PoC
# ==============================================================================

# LiteLLM Master Admin Key (proxy_admin role)
LITELLM_MASTER_KEY=sk-enterprise-master-secret-key-2026

# Upstream Cloud LLM API Keys (Optional if running against offline mock-model)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# OpenTelemetry Endpoint (Use http://localhost:4317 for host; http://jaeger:4317 inside Docker)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Virtual API Key for Client Bridges (e.g. Claude Desktop via scripts/mcp_bridge.py)
LITELLM_API_KEY=sk-agent-claude-desktop

